{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scout-report",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  // Gera public/js/comum/dados.gen.js a partir de ../partilhado/*.json antes de cada dev/deploy. Com um build
  // próprio, o `wrangler dev` só recarrega o que estiver em watch_dir: por isso o src/ também lá está.
  "build": {
    "command": "node scripts/gerar-dados.mjs",
    "watch_dir": ["src", "public/js/comum", "../partilhado"]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/", "/index.html", "/api/*", "/ws/*", "/sala/*", "/dia", "/dia/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "SALAS", "class_name": "Sala" }]
  },
  // SQLite é obrigatório para Durable Objects no plano gratuito.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Sala"] }],
  // A base de jogadores (pipeline: python -m scout exportar). Em `wrangler dev` usa-se uma cópia local
  // (npm run db:local); a remota carrega-se com `npm run db:remoto`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "scout-report",
      "database_id": "e30df41d-d2fb-494f-a262-c54de6dbe8a6",
      "migrations_dir": "migrations"
    }
  ],
  // O dia do Relatório #1 do Desafio do Dia (data de Lisboa): o do primeiro deploy.
  "vars": { "DIA_LANCAMENTO": "2026-10-25" },
  "observability": { "enabled": true }
}
