{
  "name": "scout-report",
  "version": "0.1.0",
  "private": true,
  "description": "Scout Report — o \"Quem é Quem\" do futebol, para jogar com os amigos.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "dados": "node scripts/gerar-dados.mjs",
    "test": "node scripts/gerar-dados.mjs && vitest run",
    "assets": "node scripts/copiar-assets.mjs",
    "contraste": "node scripts/contraste.mjs",
    "db:local": "wrangler d1 migrations apply scout-report --local && node scripts/carregar-d1.mjs",
    "e2e": "node scripts/e2e.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/caveat": "^5.2.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/courier-prime": "^5.2.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  }
}
